{
 "name": "zynote",
 "version": "0.0.1",
 "private": true,
 "description": "Zynote：课堂字幕、教师重点与课后练习（Go 后端）",
 "author": {
  "name": "Zynote contributors"
 },
 "license": "AGPL-3.0-only",
 "type": "module",
 "main": "out/main/main.js",
 "packageManager": "pnpm@11.8.0",
 "scripts": {
  "dev": "node scripts/ensure-go-core.mts && electron-vite dev",
  "start": "electron .",
  "typecheck": "tsc --noEmit && tsc -p tsconfig.migrations.json",
  "build": "pnpm typecheck && electron-vite build",
  "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
  "backend:build": "cd backend && go build -trimpath -ldflags=\"-s -w\" -o bin/zynote-core ./cmd/zynote-core",
  "backend:test": "cd backend && go test ./...",
  "native:build": "cargo build --manifest-path native/Cargo.toml --release",
  "native:test": "cargo test --manifest-path native/Cargo.toml",
  "smoke:go-core": "node scripts/go-core-smoke.mts",
  "acquire:asr": "node scripts/acquire-asr-model.mts",
  "acquire:embedding": "node scripts/acquire-embedding-model.mts",
  "parity:pdf": "node scripts/pdf-parity.mts",
  "parity:discussion": "ELECTRON_RUN_AS_NODE=1 electron scripts/discussion-roundtrip.mts",
  "parity:knowledge": "ELECTRON_RUN_AS_NODE=1 electron scripts/knowledge-roundtrip.mts",
  "parity:embedding": "ELECTRON_RUN_AS_NODE=1 electron scripts/embedding-parity.mts",
  "pack": "pnpm build && pnpm release full",
  "release": "node scripts/release.mts",
  "release:source": "node scripts/source-package.mts",
  "runtime:smoke": "node scripts/runtime-smoke.mts",
  "lint": "biome lint .",
  "format": "biome format --write .",
  "check": "biome check .",
  "check:contract": "node scripts/check-contract.mts",
  "check:fix": "biome check --write .",
  "verify": "pnpm typecheck && pnpm check && pnpm check:contract"
 },
 "dependencies": {
  "@heroui/react": "^3.2.6",
  "@heroui/styles": "^3.2.6",
  "@huggingface/transformers": "4.3.1",
  "@internationalized/date": "3.12.4",
  "ajv": "8.20.0",
  "better-sqlite3": "^12.4.1",
  "better-sqlite3-multiple-ciphers": "13.0.3",
  "docx": "^9.5.1",
  "entities": "8.1.0",
  "htmlparser2": "12.0.0",
  "iconv-lite": "^0.7.0",
  "jschardet": "^3.1.4",
  "jszip": "^3.10.2",
  "koffi": "3.3.3",
  "lucide-react": "^1.58.0",
  "mammoth": "^1.10.0",
  "onnxruntime-node": "1.30.0",
  "pdf-lib": "^1.17.1",
  "pdfjs-dist": "^6.3.289",
  "qr": "0.7.2",
  "quickjs-emscripten": "0.32.0",
  "react": "^19.2.0",
  "react-dom": "^19.2.0",
  "react-markdown": "^10.1.0",
  "remark-gfm": "^4.0.1",
  "saxes": "6.0.0",
  "tough-cookie": "6.0.2",
  "undici": "8.12.1",
  "youtubei.js": "18.1.0",
  "zod": "^4.1.12"
 },
 "devDependencies": {
  "@biomejs/biome": "^2.5.15",
  "@tailwindcss/vite": "4.3.3",
  "@types/better-sqlite3": "^7.6.13",
  "@types/node": "^24.10.0",
  "@types/react": "^19.2.0",
  "@types/react-dom": "^19.2.0",
  "@vitejs/plugin-react": "^5.1.0",
  "electron": "42.11.10",
  "electron-builder": "^26.0.12",
  "electron-vite": "^4.0.1",
  "esbuild": "0.25.12",
  "playwright": "^1.63.0",
  "tailwindcss": "4.3.3",
  "tw-animate-css": "^1.4.0",
  "typescript": "^5.9.3",
  "vite": "^7.2.0",
  "vitest": "5.0.3"
 },
 "build": {
  "appId": "org.listening-assistant.desktop",
  "productName": "Zynote",
  "directories": {
   "output": "release"
  },
  "files": [
   "out/**",
   "package.json",
   "LICENSE",
   "NOTICE",
   "docs/legal/THIRD_PARTY_NOTICES.md",
   "!node_modules/http-cache-semantics/**",
   "!node_modules/@derhuerst/http-basic/**",
   "!node_modules/ffmpeg-static/install.js",
   "!**/*.py",
   "!**/*.pyc",
   "!**/__pycache__/**"
  ],
  "extraResources": [
   {
    "from": "backend/bin",
    "to": "bin",
    "filter": [
     "zynote-core",
     "zynote-native"
    ]
   },
   {
    "from": "resources/pdfium",
    "to": "pdfium",
    "filter": [
     "libpdfium.dylib",
     "pdfium.dll",
     "libpdfium.so"
    ]
   },
   {
    "from": "resources/knowledge",
    "to": "knowledge",
    "filter": [
     "onnx-bge/**",
     "vendor/NapCat.Shell.Windows.Node.zip",
     "BiliSum-LICENSE"
    ]
   },
   {
    "from": "src/prompts",
    "to": "prompts",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   },
   {
    "to": "icon.png",
    "from": "resources/icon.png",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   },
   {
    "from": "resources/video",
    "to": "video",
    "filter": [
     "ffmpeg.exe",
     "ffprobe.exe",
     "ffmpeg",
     "ffprobe",
     "LICENSE-ffmpeg-static.txt",
     "LICENSE-ffprobe.txt"
    ]
   },
   {
    "from": "resources/asr",
    "to": "asr",
    "filter": [
     "onnx-small/**"
    ]
   },
   {
    "from": "resources/runtime-manifest.json",
    "to": "runtime-manifest.json",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   }
  ],
  "asarUnpack": [
   "node_modules/@jitl/**/*.wasm",
   "node_modules/@koromix/**",
   "node_modules/better-sqlite3-multiple-ciphers/**",
   "node_modules/better-sqlite3/**",
   "node_modules/koffi/**",
   "node_modules/onnxruntime-node/**"
  ],
  "win": {
   "target": "nsis",
   "icon": "resources/icon.ico"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": true
  },
  "mac": {
   "target": [
    "dmg",
    "zip"
   ],
   "icon": "resources/icon.png",
   "category": "public.app-category.education"
  },
  "linux": {
   "target": [
    "AppImage",
    "deb"
   ],
   "icon": "resources/icon.png",
   "category": "Education",
   "maintainer": "Zynote contributors"
  },
  "npmRebuild": true
 }
}
