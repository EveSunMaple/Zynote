{
 "name": "zynote",
 "version": "0.0.1",
 "private": true,
 "description": "Zynote：课堂字幕、教师重点与课后练习（Go 后端）",
 "author": {
  "name": "Zynote contributors"
 },
 "license": "AGPL-3.0-only",
 "type": "module",
 "main": "out/main/main.js",
 "packageManager": "pnpm@11.8.0",
 "scripts": {
  "dev": "node scripts/ensure-go-core.mts && electron-vite dev",
  "start": "electron .",
  "typecheck": "tsc --noEmit && tsc -p tsconfig.migrations.json",
  "build": "pnpm typecheck && electron-vite build",
  "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
  "backend:build": "node scripts/build-binaries.mts",
  "backend:test": "cd backend && go test ./...",
  "native:build": "cargo build --manifest-path native/Cargo.toml --release",
  "native:test": "cargo test --manifest-path native/Cargo.toml",
  "smoke:go-core": "node scripts/go-core-smoke.mts",
  "acquire:asr": "node scripts/acquire-asr-model.mts",
  "acquire:embedding": "node scripts/acquire-embedding-model.mts",
  "pack": "pnpm build && pnpm release full",
  "release": "node scripts/release.mts",
  "release:source": "node scripts/source-package.mts",
  "release:checksums": "node scripts/release-checksums.mts",
  "package:smoke": "node scripts/package-smoke.mts",
  "update:smoke": "node scripts/update-smoke.mts",
  "e2e:packaged": "node scripts/packaged-e2e.mts",
  "perf:smoke": "node scripts/perf-smoke.mts",
  "migration:drill": "node scripts/migration-drill.mts",
  "lint": "biome lint .",
  "format": "biome format --write .",
  "check": "biome check .",
  "check:contract": "node scripts/check-contract.mts",
  "check:fix": "biome check --write .",
  "verify": "pnpm typecheck && pnpm check && pnpm check:contract"
 },
 "dependencies": {
  "@heroui/react": "^3.2.6",
  "@heroui/styles": "^3.2.6",
  "@internationalized/date": "3.12.4",
  "electron-updater": "^6.8.11",
  "katex": "^0.19.1",
  "koffi": "3.3.3",
  "lucide-react": "^1.58.0",
  "pdfjs-dist": "^6.3.289",
  "react": "^19.2.0",
  "react-dom": "^19.2.0",
  "react-markdown": "^10.1.0",
  "rehype-katex": "^7.0.1",
  "remark-gfm": "^4.0.1",
  "remark-math": "^6.0.0",
  "zod": "^4.1.12"
 },
 "devDependencies": {
  "@biomejs/biome": "^2.5.15",
  "@electron/notarize": "^3.1.2",
  "@huggingface/transformers": "4.3.1",
  "@tailwindcss/vite": "4.3.3",
  "@types/node": "^24.10.0",
  "@types/react": "^19.2.0",
  "@types/react-dom": "^19.2.0",
  "@vitejs/plugin-react": "^5.1.0",
  "electron": "42.11.10",
  "electron-builder": "^26.0.12",
  "electron-vite": "^4.0.1",
  "esbuild": "0.25.12",
  "jszip": "^3.10.2",
  "pdf-lib": "^1.17.1",
  "playwright": "^1.63.0",
  "tailwindcss": "4.3.3",
  "tw-animate-css": "^1.4.0",
  "typescript": "^5.9.3",
  "undici": "8.12.1",
  "vite": "^7.2.0",
  "vitest": "5.0.3"
 },
 "build": {
  "appId": "org.listening-assistant.desktop",
  "productName": "Zynote",
  "directories": {
   "output": "release"
  },
  "files": [
   "out/**",
   "package.json",
   "LICENSE",
   "NOTICE",
   "docs/legal/THIRD_PARTY_NOTICES.md",
   "!node_modules/http-cache-semantics/**",
   "!node_modules/@derhuerst/http-basic/**",
   "!node_modules/ffmpeg-static/install.js",
   "!**/*.py",
   "!**/*.pyc",
   "!**/__pycache__/**"
  ],
  "extraResources": [
   {
    "from": "backend/bin",
    "to": "bin",
    "filter": [
     "zynote-core",
     "zynote-core.exe",
     "zynote-native",
     "zynote-native.exe",
     "DirectML.dll",
     "msvcp140.dll",
     "msvcp140_1.dll",
     "vcruntime140.dll",
     "vcruntime140_1.dll"
    ]
   },
   {
    "from": "resources/pdfium",
    "to": "pdfium",
    "filter": [
     "libpdfium.dylib",
     "pdfium.dll",
     "libpdfium.so"
    ]
   },
   {
    "from": "resources/knowledge",
    "to": "knowledge",
    "filter": [
     "onnx-bge/**",
     "BiliSum-LICENSE"
    ]
   },
   {
    "from": "resources/knowledge/vendor",
    "to": "knowledge/vendor",
    "filter": [
     "NapCat.Shell.Windows.Node.zip"
    ]
   },
   {
    "from": "src/prompts",
    "to": "prompts",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   },
   {
    "to": "icon.png",
    "from": "resources/icon.png",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   },
   {
    "from": "resources/video",
    "to": "video",
    "filter": [
     "ffmpeg.exe",
     "ffprobe.exe",
     "ffmpeg",
     "ffprobe",
     "LICENSE-ffmpeg-static.txt",
     "LICENSE-ffprobe.txt"
    ]
   },
   {
    "from": "resources/asr",
    "to": "asr",
    "filter": [
     "onnx-small/**"
    ]
   },
   {
    "from": "resources/runtime-manifest.json",
    "to": "runtime-manifest.json",
    "filter": [
     "**/*",
     "!**/__pycache__/**",
     "!**/*.pyc"
    ]
   }
  ],
  "asarUnpack": [
   "node_modules/koffi/**"
  ],
  "win": {
   "target": "nsis",
   "icon": "resources/icon.ico"
  },
  "nsis": {
   "oneClick": false,
   "allowToChangeInstallationDirectory": true,
   "createDesktopShortcut": true
  },
  "mac": {
   "target": [
    "dmg",
    "zip"
   ],
   "icon": "resources/icon.png",
   "category": "public.app-category.education",
   "hardenedRuntime": true,
   "gatekeeperAssess": false,
   "entitlements": "resources/entitlements.mac.plist",
   "entitlementsInherit": "resources/entitlements.mac.plist"
  },
  "linux": {
   "target": [
    "AppImage",
    "deb"
   ],
   "icon": "resources/icon.png",
   "category": "Education",
   "maintainer": "Zynote contributors"
  },
  "npmRebuild": true,
  "publish": {
   "provider": "github",
   "owner": "EveSunMaple",
   "repo": "Zynote",
   "releaseType": "release"
  }
 }
}
