{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "JSON-RPC envelope",
 "type": "object",
 "required": ["jsonrpc"],
 "properties": {
  "jsonrpc": { "const": "2.0" },
  "id": { "type": "string" },
  "method": { "type": "string", "minLength": 1 },
  "params": { "type": "object" },
  "result": {},
  "error": {
   "type": "object",
   "required": ["code", "message"],
   "properties": {
    "code": { "type": "string" },
    "message": { "type": "string", "minLength": 1 },
    "data": {}
   }
  }
 }
}
