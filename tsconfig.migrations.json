{
 "compilerOptions": {
  "target": "ES2022",
  "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
  "module": "NodeNext",
  "moduleResolution": "NodeNext",
  "strict": true,
  "noEmit": true,
  "allowImportingTsExtensions": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "types": ["node"]
 },
 "include": ["scripts/*.mts"]
}
